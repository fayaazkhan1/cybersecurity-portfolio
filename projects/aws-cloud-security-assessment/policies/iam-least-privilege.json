{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLabBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::fayaaz-cloudsec-lab-657333"
    },
    {
      "Sid": "ReadLabObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::fayaaz-cloudsec-lab-657333/*"
    }
  ]
}
